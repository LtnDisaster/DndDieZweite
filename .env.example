# Copy to .env (which is git-ignored) and adjust. All values are optional;
# the app runs fine with none of them set (local HTTP development).

# Where SQLite db, secret.key and uploads metadata live. Default: ./data
VTT_DATA_DIR=./data

# uvicorn bind (run.sh reads these)
HOST=127.0.0.1
PORT=8000

# Set to 1 only when serving behind HTTPS. Adds the Secure flag to the session
# cookie. Leave unset for plain-HTTP local development.
VTT_COOKIE_SECURE=0

# Set to 1 ONLY when a trusted reverse proxy sets X-Forwarded-For AND
# X-Forwarded-Proto. Only then are those headers trusted for the login/register
# rate limiter and the Secure-cookie decision. Never set this on a box that is
# directly reachable from the internet.
VTT_TRUST_PROXY=0

# Extra origins allowed for the WebSocket handshake (comma-separated), e.g.
# https://vtt.example.org. Same-origin requests are always allowed. Leave unset
# for single-host use.
# VTT_ALLOWED_ORIGINS=https://vtt.example.org

# Log level: DEBUG / INFO / WARNING
VTT_LOG_LEVEL=INFO
