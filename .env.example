# Copy to .env (which is git-ignored) and adjust. All values are optional;
# the app runs fine with none of them set (local HTTP development).

# Where SQLite db, secret.key and uploads metadata live. Default: ./data
VTT_DATA_DIR=./data

# uvicorn bind (run.sh reads these)
HOST=127.0.0.1
PORT=8000

# Set to 1 only when serving behind HTTPS. Adds the Secure flag to the session
# cookie. Leave unset for plain-HTTP local development.
VTT_COOKIE_SECURE=0

# Set to 1 ONLY when a trusted reverse proxy sets X-Forwarded-For and you want
# the login/register rate limiter to key on the real client IP.
VTT_TRUST_PROXY=0

# Log level: DEBUG / INFO / WARNING
VTT_LOG_LEVEL=INFO
