# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Virtualenv
.venv/
venv/

# Runtime data (generated at startup, never commit)
data/
*.db
*.db-wal
*.db-shm
*.key
secret.key

# User-uploaded map images (runtime)
app/static/uploads/*
!app/static/uploads/.gitkeep

# Local config / secrets
.env
*.local

# Logs / tmp
*.log
tmp/

# Packaging / Windows mark-of-the-web artifacts
*.zip
*.tar.gz
*Zone.Identifier

# Docker compose local overrides (proxy ports, extra env)
compose.override.yaml
compose.override.yml
